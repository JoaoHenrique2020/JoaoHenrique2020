    {
      "cell_type": "code",
      "source": [
        "plt.figure(figsize=(8, 5))\n",
        "plt.plot(distances, energies, marker= 'o', color = 'darkblue')\n",
        "plt.xlabel(\"Distâncias H-H (Ã)\", fontsize=12)\n",
        "plt.ylabel(\"Energia (Hartree)\", fontsize=12)\n",
        "plt.title(\"Curva de energia do H2 (CIRCUITO FIXO)\", fontsize=14)\n",
